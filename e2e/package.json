{
  "name": "mssp-control-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright end-to-end tests for Admin (:3000) and Customer (:3001) portals.",
  "scripts": {
    "test": "playwright test",
    "test:live": "playwright test --grep-invert @mocked",
    "test:mocked": "playwright test --grep @mocked",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.51.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
