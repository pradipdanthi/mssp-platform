NIKTIAR_CONTROL_URL=http://192.168.0.201:8000
# Required — pins this appliance to one customer (dedicated only)
NIKTIAR_TENANT_CODE=ACME
NIKTIAR_APPLIANCE_TOKEN=
SECURE_EDGE_HOSTNAME=edge-acme-a
# Product default: dedicated (shared multi-tenant is not offered)
SECURE_EDGE_MODE=dedicated
# ha_pair (virtual HA) | physical (1U boxes at customer site)
SECURE_EDGE_FORM_FACTOR=ha_pair
SECURE_EDGE_HA_ROLE=primary
EDGE_DASHBOARD_USER=admin
EDGE_DASHBOARD_PASSWORD=NikTiarEdge!ChangeMe
ACME_EMAIL=ops@niktiar.local
# Optional commercial DNS category feed
# NIKTIAR_DNS_COMMERCIAL_FEED_URL=
# NIKTIAR_DNS_COMMERCIAL_API_KEY=
# LAN IP for DNS :53 (avoid conflict with systemd-resolved on 127.0.0.53)
NIKTIAR_DNS_BIND_IP=192.168.0.217
