{
  order coraza_waf first
  auto_https disable_redirects
}

# Default catch-all — replace hostnames via portal/agent later
:80 {
  coraza_waf {
    load_owasp_crs
    directives `
      Include @coraza.conf-recommended
      Include @crs-setup.conf.example
      Include @owasp_crs/*.conf
      SecRuleEngine On
    `
  }
  log {
    output file /var/log/coraza/access.log
  }
  respond "NikTiar Secure Edge online — configure upstream origins" 200
}

