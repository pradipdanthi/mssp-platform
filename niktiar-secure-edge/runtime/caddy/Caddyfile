# NikTiar Secure Edge — Coraza WAF + hybrid multi-tenant + rate shields
{
	order coraza_waf first
	log {
		level WARN
	}
	admin 127.0.0.1:2019
	# Optional email for ACME (set via env in future bake)
	email {$ACME_EMAIL:ops@niktiar.local}
}

(coraza_block) {
	coraza_waf {
		include /opt/coraza/config/coraza.conf
		include /opt/coraza/config.d/*.conf
		include /opt/coraza/config/crs-setup.conf
		include /opt/coraza/owasp-crs/plugins/*-config.conf
		include /opt/coraza/owasp-crs/plugins/*-before.conf
		include /opt/coraza/plugins/*-config.conf
		include /opt/coraza/plugins/*-before.conf
		include /opt/coraza/owasp-crs/rules/*.conf
		include /opt/coraza/owasp-crs/plugins/*-after.conf
		include /opt/coraza/plugins/*-after.conf
		include /opt/coraza/rules/*.conf
		include /opt/coraza/rules.d/*.conf
		include /opt/coraza/overrides/*.conf
	}
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

:8080 {
	import coraza_block
	import security_headers

	handle /healthz {
		respond "niktiar-secure-edge-ok" 200
	}

	handle /edge-info {
		respond "NikTiar Secure Edge — Coraza CRS · CrowdSec · hybrid multi-tenant · dashboard :9080" 200
	}

	# Basic abuse shield: huge URI / obvious scanners still hit CRS; soft request ceiling
	@abuse path_regexp (?i)(wp-login|xmlrpc\.php|\.env|phpmyadmin)
	handle @abuse {
		respond "Blocked" 403
	}

	import /runtime/sites.caddy

	handle {
		reverse_proxy http://origin:80 {
			trusted_proxies private_ranges
		}
	}

	log {
		output file /runtime/niktiar-access.log
		format json
	}
}

# TLS listener (host maps 443→8443). ACME sites imported from sites_tls.caddy
:8443 {
	import coraza_block
	import security_headers
	import /runtime/sites_tls.caddy

	handle {
		respond "NikTiar Secure Edge TLS — configure site tls_mode=acme + public DNS" 200
	}

	log {
		output file /runtime/niktiar-access.log
		format json
	}
}
