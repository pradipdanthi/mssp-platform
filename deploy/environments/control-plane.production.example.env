# KB-094 — Control plane environment (PRODUCTION / CLOUD)
# Copy to /opt/mssp-control/.env on the production host. Never commit filled values.

APP_ENV=production
# Cloud default UTC; on-prem India lab/production use Asia/Kolkata (same offset as Asia/Calcutta).
TZ=UTC

# --- Database ---
POSTGRES_DB=mssp_control
POSTGRES_USER=mssp_admin
POSTGRES_PASSWORD=<REQUIRED>

# --- Redis ---
REDIS_PASSWORD=<REQUIRED>

# --- API (behind reverse proxy or load balancer in production) ---
API_PORT=8000
JWT_SECRET=<REQUIRED>

# --- Public portals (TLS terminated at nginx / cloud LB) ---
ADMIN_PORTAL_BASE_URL=https://admin.kevantic.com
CUSTOMER_PORTAL_BASE_URL=https://portal.kevantic.com
PLATFORM_ROOT_DOMAIN=kevantic.com
CORS_ALLOWED_ORIGINS=https://admin.kevantic.com,https://portal.kevantic.com

# --- Email ---
RESEND_API_KEY=<REQUIRED_FOR_ONBOARDING_EMAIL>
RESEND_FROM_EMAIL=Kevantic MSSP <noreply@kevantic.com>
SALES_NOTIFY_EMAIL=sales@kevantic.com

# --- Engine adapters — use private hostnames or internal IPs (see engines.production.example.env) ---
WAZUH_API_URL=https://wazuh.internal.example:55000
WAZUH_API_VERIFY_TLS=true
WAZUH_DEFAULT_TENANT_SHORT_CODE=
THEHIVE_URL=https://thehive.internal.example:9000
THEHIVE_USER=<REQUIRED>
THEHIVE_DEFAULT_ORG=MSSP
MISP_URL=https://misp.internal.example
MISP_VERIFY_TLS=true
VELOCIRAPTOR_SERVER_URL=https://velociraptor.internal.example:8001
EASM_DISPATCH_MODE=remote

# --- Azure / ITDR (if entitled) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
