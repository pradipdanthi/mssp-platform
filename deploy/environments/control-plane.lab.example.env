# KB-094 — Control plane environment (LAB / VM 100)
# Copy to /opt/mssp-control/.env and replace every <REQUIRED> value.
# Never commit the filled .env file.

APP_ENV=development
TZ=Asia/Kolkata

# --- Database (Compose service: postgres) ---
POSTGRES_DB=mssp_control
POSTGRES_USER=mssp_admin
POSTGRES_PASSWORD=<REQUIRED>

# --- Redis ---
REDIS_PASSWORD=<REQUIRED>

# --- API ---
API_PORT=8000
JWT_SECRET=<REQUIRED>

# --- Portals (lab uses IPs; production uses kevantic.com subdomains) ---
ADMIN_PORTAL_BASE_URL=http://192.168.0.201:3000
CUSTOMER_PORTAL_BASE_URL=http://192.168.0.201:3001
PLATFORM_ROOT_DOMAIN=kevantic.com
# Optional: comma-separated browser origins for direct API access
CORS_ALLOWED_ORIGINS=http://192.168.0.201:3000,http://192.168.0.201:3001,http://localhost:3000,http://localhost:3001

# --- Email (optional in lab) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=MSSP Control Plane <onboarding@resend.dev>
SALES_NOTIFY_EMAIL=sales@kevantic.com

# --- Engine adapters (lab defaults — see engines.lab.example.env) ---
WAZUH_API_URL=https://192.168.0.211:55000
WAZUH_API_VERIFY_TLS=false
WAZUH_DEFAULT_TENANT_SHORT_CODE=
THEHIVE_URL=http://192.168.0.212:9000
THEHIVE_USER=admin@thehive.local
THEHIVE_DEFAULT_ORG=MSSP
MISP_URL=http://192.168.0.218:8080
MISP_VERIFY_TLS=false
VELOCIRAPTOR_SERVER_URL=http://192.168.0.220:8001
EASM_DISPATCH_MODE=remote

# --- Azure / ITDR (optional) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
