# KB-094 — Engine adapter URLs (LAB). Merge into control-plane .env.
# Credentials live in .secrets/ files mounted by docker-compose.yml — not here.

# VM 101 — Wazuh Manager API
WAZUH_API_URL=https://192.168.0.211:55000
WAZUH_API_VERIFY_TLS=false

# VM 102 — TheHive
THEHIVE_URL=http://192.168.0.212:9000
THEHIVE_USER=admin@thehive.local
THEHIVE_DEFAULT_ORG=MSSP

# VM 108 — MISP
MISP_URL=http://192.168.0.218:8080
MISP_VERIFY_TLS=false

# VM 110 — Velociraptor
VELOCIRAPTOR_SERVER_URL=http://192.168.0.220:8001

# VM 109 — Greenbone / Nuclei / Vuls (adapter sync from control plane)
# No URL in .env — scanners push to control plane ingest APIs.

# Appliance management (KB-093L) — heartbeat/register edge (not SOC telemetry)
# Appliances: JUNEXIS_CONTROL_PLANE=http://192.168.0.224:8000
# Critical alerts: JUNEXIS_TELEMETRY_URL=http://192.168.0.201:8000/api/v1/telemetry/ingest
