# KB-094 — Engine adapter URLs (PRODUCTION / CLOUD). Merge into control-plane .env.
# Replace example.internal hostnames with your VPC private DNS or service endpoints.

WAZUH_API_URL=https://wazuh-manager.internal.example:55000
WAZUH_API_VERIFY_TLS=true

THEHIVE_URL=https://thehive.internal.example:9000
THEHIVE_USER=<REQUIRED>
THEHIVE_DEFAULT_ORG=MSSP

MISP_URL=https://misp.internal.example
MISP_VERIFY_TLS=true

VELOCIRAPTOR_SERVER_URL=https://velociraptor.internal.example:8001

# Appliance routing (locked model — KB-093P):
# - Heartbeat / register → appliance management plane host
# - High/critical alert metadata → SOC control plane /api/v1/telemetry/ingest
# Set on each appliance via register + kevantic-cli; golden image 199 bakes forwarder.
