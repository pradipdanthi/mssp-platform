# Copy to the Windows AR install folder as mssp-ar.env (never commit real keys).
# Used by mssp-isolate-host.ps1 for Manager allow-list + KB-091 endpoint callbacks.
WAZUH_MANAGER_IP=192.168.0.211
# Optional explicit control-plane IP (also inferred from MSSP_CALLBACK_URL host).
MSSP_CONTROL_PLANE_IP=192.168.0.201
MSSP_CALLBACK_URL=http://192.168.0.201:8000/v1/edr/actions/callback
# Use the same value as control-plane .secrets/soc_sync_api_key until per-execution tokens land.
MSSP_CALLBACK_KEY=<REDACTED>
