#!/usr/bin/env python3
"""MSSP AR: temporary host isolation via iptables. Reads Wazuh execd JSON from stdin."""
import json
import os
import subprocess
import sys
from datetime import datetime

LOG = "/var/ossec/logs/active-responses.log"
CHAIN = "MSSP_ISOLATE"
MANAGER = os.environ.get("WAZUH_MANAGER_IP", "192.168.0.211")


def log(msg: str) -> None:
    try:
        with open(LOG, "a", encoding="utf-8") as fh:
            fh.write(f"{datetime.utcnow().strftime('%Y/%m/%d %H:%M:%S')} mssp-isolate-host: {msg}\n")
    except OSError:
        pass


def run(cmd: list[str]) -> None:
    subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def isolate_delete() -> None:
    run(["iptables", "-D", "OUTPUT", "-j", CHAIN])
    run(["iptables", "-F", CHAIN])
    run(["iptables", "-X", CHAIN])
    log("ISOLATE delete")


def isolate_add(seconds: int) -> None:
    run(["iptables", "-N", CHAIN])
    run(["iptables", "-F", CHAIN])
    run(["iptables", "-A", CHAIN, "-o", "lo", "-j", "ACCEPT"])
    run(["iptables", "-A", CHAIN, "-m", "conntrack", "--ctstate", "ESTABLISHED,RELATED", "-j", "ACCEPT"])
    run(["iptables", "-A", CHAIN, "-d", MANAGER, "-j", "ACCEPT"])
    run(["iptables", "-A", CHAIN, "-d", "192.168.0.211", "-j", "ACCEPT"])
    run(["iptables", "-A", CHAIN, "-p", "udp", "--dport", "53", "-j", "ACCEPT"])
    run(["iptables", "-A", CHAIN, "-p", "tcp", "--dport", "53", "-j", "ACCEPT"])
    run(["iptables", "-A", CHAIN, "-j", "REJECT", "--reject-with", "icmp-host-prohibited"])
    # Insert hook if missing
    check = subprocess.run(["iptables", "-C", "OUTPUT", "-j", CHAIN], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if check.returncode != 0:
        run(["iptables", "-I", "OUTPUT", "1", "-j", CHAIN])
    log(f"ISOLATE add seconds={seconds} manager={MANAGER}")
    if seconds > 0:
        subprocess.Popen(
            [
                "bash",
                "-c",
                f"sleep {seconds}; iptables -D OUTPUT -j {CHAIN} 2>/dev/null; "
                f"iptables -F {CHAIN} 2>/dev/null; iptables -X {CHAIN} 2>/dev/null; "
                f"echo \"$(date '+%Y/%m/%d %H:%M:%S') mssp-isolate-host: ISOLATE delete\" >> {LOG}",
            ]
        )


def main() -> int:
    raw = sys.stdin.readline()
    if not raw.strip() and len(sys.argv) > 1:
        raw = sys.argv[1]
    try:
        data = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        data = {}
    cmd = str(data.get("command") or "add").lower()
    args = (data.get("parameters") or {}).get("extra_args") or data.get("arguments") or []
    # Control-plane UNISOLATE_HOST sends arguments=["delete"].
    if args and str(args[0]).lower() in ("delete", "remove", "unisolate"):
        cmd = "delete"
    seconds = 0
    if args and cmd not in ("delete", "remove"):
        try:
            seconds = int(args[0])
        except ValueError:
            seconds = 0
    seconds = max(0, min(seconds, 86400))
    if os.environ.get("MSSP_ALLOW_TIMED_ISOLATE") != "1":
        seconds = 0
    if cmd in ("delete", "remove"):
        isolate_delete()
    else:
        isolate_add(seconds)
    return 0


if __name__ == "__main__":
    sys.exit(main())
