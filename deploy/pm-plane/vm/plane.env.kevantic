# Kevantic lab — Plane on VirtualBox (NAT: host localhost:8080 -> guest :80)
APP_RELEASE=stable

WEB_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# Change these before any internet-exposed deployment
POSTGRES_PASSWORD=kevantic_plane_pg_change_me
AWS_ACCESS_KEY_ID=kevantic-minio-access
AWS_SECRET_ACCESS_KEY=kevantic-minio-secret-change-me

# Email optional for lab — configure when you want notifications
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
