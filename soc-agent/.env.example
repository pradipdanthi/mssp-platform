SOC_AGENT_INGEST_TOKEN=ChangeMe-SocAgent-Ingest-Token
SOC_AGENT_NAME=mssp-soc-agent
# REQUIRED — Cursor subscription API key (Dashboard → Cursor Settings → API Keys)
CURSOR_API_KEY=
# Optional model override (leave empty for account default).
# Cursor CLI has ~7–10s floor even for tiny prompts; pick a faster model from
# `agent models` if you want lower latency (e.g. a mini / flash SKU your plan allows).
CURSOR_AGENT_MODEL=
SOC_AGENT_LLM_TIMEOUT=90
# Optional free OSINT keys
OTX_API_KEY=
ABUSEIPDB_API_KEY=
# Ollama is intentionally NOT used by this agent (control-plane Tier-1 only)
