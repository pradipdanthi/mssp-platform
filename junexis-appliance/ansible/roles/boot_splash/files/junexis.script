# Junexis Appliance Plymouth script theme — static centered splash
# Brand art: junexis-boot.png (yellow→red title, white tagline, black bg)

wallpaper_image = Image("junexis-boot.png");
wallpaper_image.Scale(Window.GetWidth(), Window.GetHeight());
wallpaper_sprite = Sprite();
wallpaper_sprite.SetImage(wallpaper_image);
wallpaper_sprite.SetX(0);
wallpaper_sprite.SetY(0);
wallpaper_sprite.SetZ(-10000);

# Progress dots (subtle, bottom-center) so boot does not look frozen
progress = 0;
fun progress_callback(progress) {
  # no-op visual; image stays full-screen
}

Plymouth.SetRefreshFunction(progress_callback);
