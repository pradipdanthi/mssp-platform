## Junexis appliance audit rules
## Identity / config / secrets / binaries — no customer raw log content here.

# Junexis config and trust material
-w /etc/junexis -p wa -k junexis_config
-w /etc/junexis/trust -p wa -k junexis_trust

# Secrets and state (API keys, license material)
-w /var/lib/junexis/secrets -p rwa -k junexis_secrets
-w /var/lib/junexis/entitlements.json -p wa -k junexis_entitlements
-w /var/lib/junexis/appliance.json -p wa -k junexis_state

# Operator CLI and reconcile tools
-w /usr/bin/junexis-cli -p x -k junexis_cli
-w /usr/bin/junexis-reconcile-services -p x -k junexis_reconcile

# Identity and privilege
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/sudoers -p wa -k scope
-w /etc/sudoers.d -p wa -k scope

# Network posture
-w /etc/junexis/nftables -p wa -k junexis_nft
-w /etc/sysctl.d/99-junexis-cis.conf -p wa -k junexis_sysctl

# Note: do not set `-e 2` here during firstboot; operators may enable
# immutable rules after network lock if policy requires.
