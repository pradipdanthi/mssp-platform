[Unit]
Description=Junexis Appliance Engine local job API (loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=junexis
Group=junexis
Environment=PYTHONPATH=/opt/junexis/appliance-src
Environment=JUNEXIS_STATE_DIR=/var/lib/junexis
Environment=JUNEXIS_LOG_DIR=/var/log/junexis
ExecStart=/usr/bin/python3 -m appliance.api.local_app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/junexis /var/log/junexis /run/junexis
PrivateTmp=true

[Install]
WantedBy=multi-user.target
