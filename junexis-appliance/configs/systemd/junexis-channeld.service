[Unit]
Description=Junexis Appliance outbound channel agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/junexis/appliance.env
Environment=PYTHONPATH=/opt/junexis/channel:/opt/junexis/cli:/opt/junexis/appliance-src:/opt/junexis/ota
Environment=JUNEXIS_STATE_DIR=/var/lib/junexis
Environment=JUNEXIS_CONFIG_DIR=/etc/junexis
ExecStart=/usr/sbin/junexis-channeld --config /etc/junexis/channel.yaml --mode auto
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/junexis /var/log/junexis /run/junexis
PrivateTmp=true

[Install]
WantedBy=multi-user.target
