[Unit]
Description=Junexis Appliance outbound channel agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=junexis
Group=junexis
ExecStart=/usr/sbin/junexis-channeld --config /etc/junexis/channel.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/junexis /run/junexis
PrivateTmp=true

[Install]
WantedBy=multi-user.target
