.cache/
.tools/
output-*/
*.qcow2
packer_cache/
**/packer-manifest.json
__pycache__/
*.pyc

# Offline engine .debs are large binary artifacts (fetch via script; embed in ISO)
iso/offline-packages/*.deb
iso/offline-packages/SHA256SUMS
iso/offline-packages/MANIFEST.txt
iso/offline-packages/bin/
iso/offline-packages/wheels/
!iso/offline-packages/README.md

# Never commit appliance secrets
**/secrets/**
**/*.pem
**/*.key
!licensing/keys/README.md
packer/vars/*.pkrvars.hcl
!packer/vars/*.example
!packer/vars/b2-docker.pkrvars.hcl
