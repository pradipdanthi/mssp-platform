#cloud-config
# Kevantic Appliance — Ubuntu 24.04 autoinstall (fully unattended)
# Remastered onto the live ISO; ds=nocloud;s=/cdrom/nocloud/
#
# IMPORTANT: `source.id: ubuntu-server-minimal` is required — without it,
# Subiquity shows the interactive "Ubuntu Server vs Minimized" screen.
autoinstall:
  version: 1
  # Force zero interactive prompts (language/keyboard/storage/identity/source).
  interactive-sections: []
  locale: en_US.UTF-8
  keyboard:
    layout: us
  # Minimized Ubuntu Server base — NOT the full "Ubuntu Server" guided option.
  source:
    id: ubuntu-server-minimal
    search_drivers: false
  identity:
    hostname: kevantic-appliance
    username: kevantic
    # Default install password: ChangeMeNow! — rotate via kevantic-cli after setup
    password: "$6$JxLabSalt9$WvtEY0IcWpnN06bXNUlDbQ6JBlfj8WlE2nKFQBhwelYs9qzt9MFcBKEyO2JDz1yBJrWDmKz4koypzl.t45D9R."
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: lvm
  packages:
    - python3
    - python3-pip
    - python3-venv
    - curl
    - ca-certificates
    - nftables
    - jq
    - rsync
    - ansible-core
  user-data:
    disable_root: true
    package_update: false
    package_upgrade: false
  late-commands:
    # Copy Kevantic payload from install media onto the target
    - curtin in-target --target=/target -- bash -c 'mkdir -p /opt/kevantic/payload /var/lib/kevantic /etc/kevantic /var/log/kevantic'
    - cp -a /cdrom/kevantic-payload/. /target/opt/kevantic/payload/
    - cp -a /cdrom/nocloud/meta-data /target/opt/kevantic/payload/iso-meta-data || true
    - curtin in-target --target=/target -- bash -c 'chmod +x /opt/kevantic/payload/kevantic-firstboot.sh || true'
    - curtin in-target --target=/target -- bash -c 'cp /opt/kevantic/payload/kevantic-firstboot.service /etc/systemd/system/kevantic-firstboot.service && systemctl enable kevantic-firstboot.service'
    - curtin in-target --target=/target -- bash -c 'echo bootstrap > /var/lib/kevantic/network_mode'
    - curtin in-target --target=/target -- bash -c 'echo "Kevantic Appliance — firstboot will minimize+harden; do not use as a general Ubuntu desktop." > /etc/motd'
  shutdown: reboot
