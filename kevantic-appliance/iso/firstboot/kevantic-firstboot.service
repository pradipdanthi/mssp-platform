[Unit]
Description=Kevantic appliance first-boot provision
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/kevantic/firstboot.done

[Service]
Type=oneshot
ExecStart=/opt/kevantic/payload/kevantic-firstboot.sh
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
