{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kevantic.com/schemas/appliance/channel-envelope-v1.json",
  "title": "KevanticApplianceChannelEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "id", "ts", "payload"],
  "properties": {
    "v": { "const": 1 },
    "type": {
      "type": "string",
      "enum": [
        "heartbeat",
        "status",
        "alert.meta",
        "control",
        "ack",
        "ota.offer",
        "license.push",
        "job"
      ]
    },
    "id": { "type": "string", "format": "uuid" },
    "ts": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "payload": { "type": "object" },
    "sig": { "type": "string", "description": "Detached Ed25519 signature (base64) for control/license/ota" }
  }
}
