#cloud-config
# Ubuntu 24.04 Subiquity autoinstall — Kevantic Appliance (single image, all features)
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: kevantic-appliance
    username: kevantic
    password: '$6$vdfmvwRlqEnpYSbw$JbhJlK2CNCn89QU0AqluK7MwiNVsmcs.kHMen3XwIXUuS0v/4SSNccnAuEk05Qgqh7CW7runifEVAmqbscqs71'
  storage:
    layout:
      name: lvm
  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEZ0FCM2Njl7mYWRkJBCWf4G8SDSMT1OhZ5G/tWJTBEJ kevantic-packer-build-only
  packages:
    - openssh-server
    - qemu-guest-agent
    - python3
    - python3-pip
    - sudo
    - ca-certificates
    - curl
    - nftables
  late-commands:
    - curtin in-target --target=/target -- systemctl enable ssh
    - curtin in-target --target=/target -- systemctl enable qemu-guest-agent || true
    - echo 'kevantic ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/kevantic
    - chmod 440 /target/etc/sudoers.d/kevantic
  user-data:
    disable_root: true
    package_update: false
    package_upgrade: false
    timezone: UTC
