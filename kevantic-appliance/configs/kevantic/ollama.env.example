# Appliance Ollama runtime profile (installed to /etc/kevantic/ollama.env).
# Set KEVANTIC_APPLIANCE_PROFILE=prod before install_appliance_ollama.sh for prod defaults.
#
# Lab (default): 4 threads, cores 0-5 pinned, model resident in RAM.
# Prod (≥8 cores): 6 threads, cores 0-5 pinned (reserve 6-7 for web/DB).

KEVANTIC_APPLIANCE_PROFILE=lab

OLLAMA_CPU_THREADS=4
OLLAMA_CORE_PINNING=0-5
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_ORIGINS=http://127.0.0.1,http://localhost

# Forwarder filter should match Ollama thread budget.
LOCAL_AI_NUM_THREAD=4
LOCAL_AI_CACHE_ENABLED=true
LOCAL_AI_CACHE_TTL_SECONDS=86400
