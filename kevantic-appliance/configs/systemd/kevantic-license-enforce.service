[Unit]
Description=Kevantic license enforce (re-verify JWS expiry and reconcile catalogue units)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/kevantic/appliance.env
EnvironmentFile=-/etc/niktiar/appliance.env
Environment=PYTHONPATH=/opt/kevantic/cli:/opt/kevantic:/opt/niktiar/cli:/opt/niktiar
ExecStart=/usr/bin/python3 -m kevantic_cli license enforce --json
Nice=10

[Install]
WantedBy=multi-user.target
