[Unit]
Description=Kevantic appliance heartbeat (health + agent inventory + job pull)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/kevantic/appliance.env
Environment=PYTHONPATH=/opt/kevantic/cli:/opt/kevantic
# Invoke the Python module directly — direct ExecStart of the bash wrapper drops agent inventory.
ExecStart=/usr/bin/python3 -m kevantic_cli heartbeat --json
Nice=10

[Install]
WantedBy=multi-user.target
