# B2 Packer builder image — Packer + QEMU/KVM + Ansible (no sudo on host required)
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl unzip git python3 python3-pip python3-apt \
      qemu-system-x86 qemu-utils ovmf openssh-client \
      xorriso genisoimage \
      ansible-core \
    && rm -rf /var/lib/apt/lists/*

ARG PACKER_VERSION=1.11.2
RUN curl -fsSL -o /tmp/packer.zip \
      "https://releases.hashicorp.com/packer/${PACKER_VERSION}/packer_${PACKER_VERSION}_linux_amd64.zip" \
    && unzip /tmp/packer.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/packer \
    && rm /tmp/packer.zip \
    && packer version

WORKDIR /work
# Default: validate; full build invoked by scripts/b2_packer_build.sh
CMD ["packer", "version"]
