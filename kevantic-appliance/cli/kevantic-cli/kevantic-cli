#!/usr/bin/env python3
"""Wrapper for /usr/bin/kevantic-cli on appliance images."""
import sys
from pathlib import Path

# Allow running from the git tree without install
_ROOT = Path(__file__).resolve().parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from kevantic_cli.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
