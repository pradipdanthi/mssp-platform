# Test image: the production image plus test-only dependencies.
# Build:  docker build -t mssp-backend-test -f backend-api/Dockerfile.test backend-api
# Never push or deploy this image.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt requirements-test.txt ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client openssl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt -r requirements-test.txt

COPY app ./app
COPY tests ./tests
CMD ["python", "-m", "unittest", "discover", "-s", "tests"]
