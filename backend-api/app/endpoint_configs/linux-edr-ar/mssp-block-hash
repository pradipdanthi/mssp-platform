#!/usr/bin/env python3
"""MSSP AR: append SHA256 denylist + optional auditd rule + control-plane callback."""
import json
import os
import subprocess
import sys
import urllib.request
from datetime import datetime
from pathlib import Path

LOG = "/var/ossec/logs/active-responses.log"
LIST = "/var/ossec/etc/mssp_blocked_hashes.txt"


def log(msg: str) -> None:
    try:
        with open(LOG, "a", encoding="utf-8") as fh:
            fh.write(
                f"{datetime.utcnow().strftime('%Y/%m/%d %H:%M:%S')} mssp-block-hash: {msg}\n"
            )
    except OSError:
        pass


def read_payload() -> dict:
    raw = sys.stdin.readline()
    if not raw.strip() and len(sys.argv) > 1:
        raw = sys.argv[1]
    try:
        return json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        return {}


def env_conf() -> dict:
    out = {}
    p = Path("/var/ossec/etc/mssp-ar.env")
    if not p.exists():
        return out
    for line in p.read_text(encoding="utf-8", errors="ignore").splitlines():
        if not line.strip() or line.strip().startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        out[k.strip()] = v.strip().strip('"').strip("'")
    return out


def post_callback(url: str, execution_id: str, applied: bool, message: str) -> None:
    if not url or not execution_id:
        return
    conf = env_conf()
    key = conf.get("MSSP_CALLBACK_KEY") or conf.get("EDR_CALLBACK_API_KEY") or ""
    body = json.dumps(
        {
            "execution_id": execution_id,
            "status": "success" if applied else "failed",
            "message": message,
            "payload": {"applied": applied, "action": "BLOCK_HASH"},
        }
    ).encode("utf-8")
    headers = {"Content-Type": "application/json"}
    if key:
        headers["X-EDR-Callback-Key"] = key
        headers["X-SOC-Sync-Key"] = key
    req = urllib.request.Request(url, data=body, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            resp.read()
            log(f"callback ok applied={applied}")
    except Exception as exc:  # noqa: BLE001
        log(f"callback failed: {exc}")


def enforce_linux(hash_hex: str) -> str:
    Path(LIST).parent.mkdir(parents=True, exist_ok=True)
    existing = []
    if Path(LIST).exists():
        existing = [ln.strip() for ln in Path(LIST).read_text().splitlines() if ln.strip()]
    if hash_hex not in existing:
        with open(LIST, "a", encoding="utf-8") as fh:
            fh.write(hash_hex + "\n")
    # Best-effort auditd watch note (does not block execution alone).
    rule = f"-w /var/ossec/etc/mssp_blocked_hashes.txt -p wa -k mssp_block_hash"
    try:
        rules = Path("/etc/audit/rules.d/mssp-block-hash.rules")
        if not rules.exists() or hash_hex not in rules.read_text(errors="ignore"):
            rules.parent.mkdir(parents=True, exist_ok=True)
            with open(rules, "a", encoding="utf-8") as fh:
                fh.write(rule + "\n")
            subprocess.run(["augenrules", "--load"], capture_output=True, check=False)
    except Exception as exc:  # noqa: BLE001
        return f"listed; auditd optional failed: {exc}"
    return "listed+auditd"


def main() -> int:
    data = read_payload()
    args = (data.get("parameters") or {}).get("extra_args") or data.get("arguments") or []
    h = str(args[0]).strip().lower() if args else ""
    execution_id = str(args[1]) if len(args) > 1 else ""
    callback_url = str(args[2]) if len(args) > 2 else ""
    if len(h) != 64 or any(c not in "0123456789abcdef" for c in h):
        log(f"invalid hash={h!r}")
        post_callback(callback_url, execution_id, False, "invalid hash")
        return 1
    try:
        detail = enforce_linux(h)
        log(f"hash blocked={h} {detail}")
        post_callback(callback_url, execution_id, True, f"hash blocked={h}; {detail}")
        return 0
    except Exception as exc:  # noqa: BLE001
        log(f"block failed: {exc}")
        post_callback(callback_url, execution_id, False, str(exc))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
