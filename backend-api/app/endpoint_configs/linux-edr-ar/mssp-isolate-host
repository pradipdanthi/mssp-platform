#!/usr/bin/env python3
"""MSSP AR: host isolation via iptables + control-plane applied callback."""
import json
import os
import subprocess
import sys
import urllib.request
from datetime import datetime
from pathlib import Path

LOG = "/var/ossec/logs/active-responses.log"
CHAIN = "MSSP_ISOLATE"
MANAGER = os.environ.get("WAZUH_MANAGER_IP", "192.168.0.211")


def log(msg: str) -> None:
    try:
        with open(LOG, "a", encoding="utf-8") as fh:
            fh.write(
                f"{datetime.utcnow().strftime('%Y/%m/%d %H:%M:%S')} mssp-isolate-host: {msg}\n"
            )
    except OSError:
        pass


def run(cmd: list[str]) -> None:
    subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _env_from_file() -> dict:
    for path in (
        Path("/var/ossec/etc/mssp-ar.env"),
        Path("/var/ossec/active-response/bin/mssp-ar.env"),
    ):
        if not path.exists():
            continue
        out = {}
        for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            out[k.strip()] = v.strip().strip('"').strip("'")
        return out
    return {}


def post_callback(
    url: str,
    execution_id: str,
    *,
    applied: bool,
    released: bool,
    message: str,
) -> None:
    if not execution_id:
        log("callback skip: no execution_id")
        return
    conf = _env_from_file()
    if not url:
        url = conf.get("MSSP_CALLBACK_URL") or ""
    if not url:
        log("callback skip: no callback URL")
        return
    key = conf.get("MSSP_CALLBACK_KEY") or conf.get("EDR_CALLBACK_API_KEY") or ""
    body = json.dumps(
        {
            "execution_id": execution_id,
            "status": "success" if applied else "failed",
            "message": message,
            "payload": {
                "applied": applied,
                "released": released,
                "action": "UNISOLATE_HOST" if released else "ISOLATE_HOST",
            },
        }
    ).encode("utf-8")
    headers = {"Content-Type": "application/json"}
    if key:
        headers["X-EDR-Callback-Key"] = key
        headers["X-SOC-Sync-Key"] = key
    req = urllib.request.Request(url, data=body, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            resp.read()
        log(f"callback ok applied={applied} released={released}")
    except Exception as exc:  # noqa: BLE001
        log(f"callback failed: {exc}")


def isolate_delete() -> None:
    run(["iptables", "-D", "OUTPUT", "-j", CHAIN])
    run(["iptables", "-F", CHAIN])
    run(["iptables", "-X", CHAIN])
    log("ISOLATE delete")


def isolate_add(seconds: int) -> None:
    conf = _env_from_file()
    manager = conf.get("WAZUH_MANAGER_IP") or MANAGER
    run(["iptables", "-N", CHAIN])
    run(["iptables", "-F", CHAIN])
    run(["iptables", "-A", CHAIN, "-o", "lo", "-j", "ACCEPT"])
    run(
        [
            "iptables",
            "-A",
            CHAIN,
            "-m",
            "conntrack",
            "--ctstate",
            "ESTABLISHED,RELATED",
            "-j",
            "ACCEPT",
        ]
    )
    run(["iptables", "-A", CHAIN, "-d", manager, "-j", "ACCEPT"])
    # Control-plane callback path (LAN lab default).
    cp = conf.get("MSSP_CONTROL_PLANE_IP") or "192.168.0.201"
    run(["iptables", "-A", CHAIN, "-d", cp, "-j", "ACCEPT"])
    run(["iptables", "-A", CHAIN, "-p", "udp", "--dport", "53", "-j", "ACCEPT"])
    run(["iptables", "-A", CHAIN, "-p", "tcp", "--dport", "53", "-j", "ACCEPT"])
    run(["iptables", "-A", CHAIN, "-j", "REJECT", "--reject-with", "icmp-host-prohibited"])
    check = subprocess.run(
        ["iptables", "-C", "OUTPUT", "-j", CHAIN],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if check.returncode != 0:
        run(["iptables", "-I", "OUTPUT", "1", "-j", CHAIN])
    log(f"ISOLATE add seconds={seconds} manager={manager}")
    if seconds > 0:
        subprocess.Popen(
            [
                "bash",
                "-c",
                f"sleep {seconds}; iptables -D OUTPUT -j {CHAIN} 2>/dev/null; "
                f"iptables -F {CHAIN} 2>/dev/null; iptables -X {CHAIN} 2>/dev/null; "
                f"echo \"$(date '+%Y/%m/%d %H:%M:%S') mssp-isolate-host: ISOLATE delete\" >> {LOG}",
            ]
        )


def main() -> int:
    raw = sys.stdin.readline()
    if not raw.strip() and len(sys.argv) > 1:
        raw = sys.argv[1]
    try:
        data = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        data = {}
    cmd = str(data.get("command") or "add").lower()
    args = (data.get("parameters") or {}).get("extra_args") or data.get("arguments") or []
    explicit = bool(args and str(args[0]).lower() in ("delete", "remove", "unisolate"))
    execution_id = str(args[1]) if len(args) > 1 else ""
    callback_url = str(args[2]) if len(args) > 2 else ""
    seconds = 0
    if args and not explicit:
        first = str(args[0]).lower()
        if first not in ("hold",):
            try:
                seconds = int(args[0])
            except ValueError:
                seconds = 0
    seconds = max(0, min(seconds, 86400))
    if os.environ.get("MSSP_ALLOW_TIMED_ISOLATE") != "1":
        seconds = 0
    if explicit:
        isolate_delete()
        post_callback(
            callback_url,
            execution_id,
            applied=True,
            released=True,
            message="ISOLATE delete applied=true released=true",
        )
    elif cmd in ("delete", "remove"):
        log("ignored wazuh timed delete; hold until Un-isolate")
    else:
        try:
            isolate_add(seconds)
            post_callback(
                callback_url,
                execution_id,
                applied=True,
                released=False,
                message="QUARANTINE ACTIVE applied=true",
            )
        except Exception as exc:  # noqa: BLE001
            log(f"ISOLATE failed: {exc}")
            post_callback(
                callback_url,
                execution_id,
                applied=False,
                released=False,
                message=f"ISOLATE failed: {exc}",
            )
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
